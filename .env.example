# ════════════════════════════════════════════════════════════════════════════════
# TenderMind Environment Configuration
# ════════════════════════════════════════════════════════════════════════════════
# Copy this file to .env in the root directory and fill in your actual values

# ─── AI Provider (Ollama) ────────────────────────────────────────────────────────
# Set MOCK_LLM="true" to simulate AI responses without needing an actual LLM running
MOCK_LLM="true"

# When MOCK_LLM="false", it will try to connect to this URL (e.g. your teammate's computer)
OLLAMA_BASE_URL="http://192.168.1.55:11434"

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────────
# This is automatically set by docker-compose if using that method
# Format: postgresql://username:password@host:port/database
# When running locally without Docker, use:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/tendermind
# Docker Compose will auto-set this to: postgresql://postgres:password@db:5432/tendermind

# ─── Redis (Celery Broker) ───────────────────────────────────────────────────────
# This is automatically set by docker-compose if using that method
# Format: redis://host:port/db
# When running locally without Docker, use:
# REDIS_URL=redis://localhost:6379/0
# Alternatively, use Upstash for cloud Redis:
# REDIS_URL=rediss://default:YOUR_PASSWORD@your-example-endpoint.upstash.io:33950

# ─── Optional: Tesseract OCR ─────────────────────────────────────────────────────
# Only needed if running without Docker
# On Windows (example): C:\Program Files\Tesseract-OCR\tesseract.exe
# On Linux/Mac: Usually auto-detected (/usr/bin/tesseract)
# TESSERACT_CMD=/usr/bin/tesseract

# ─── Optional: Logging Level ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
